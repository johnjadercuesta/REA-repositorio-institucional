PORT=4000
# En producción poné un JWT_SECRET fuerte (genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=secreto-de-demo-cambiar-en-produccion
JWT_EXPIRES=12h
DB_PATH=./data/rea.db
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
# En producción: ruta del build SPA (por defecto frontend/dist)
#SPA_DIST=./frontend/dist